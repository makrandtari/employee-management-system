<div class="container">
  <div class="row">

    <div class="col-md-6">
      <%# Changed model to @employee (singular) %>
      <%= form_with model: @employee, url: employee_index_path, method: :post do |f| %>

        <% if @employee&.errors&.any? %>
          <div class="errors">
            <h3>Please fix these errors:</h3>
            <% @employee.errors.full_messages.each do |message| %>
              <p><%= message %></p>
            <% end %>
          </div>
        <% end %>

        <div>
          <%= f.label :name %>
          <%= f.text_field :name %>
        </div>

        <div>
          <%= f.label :email %>
          <%= f.text_field :email %>
        </div>

        <div>
          <%= f.label :phone %>
          <%= f.text_field :phone %>
        </div>

        <div>
          <%= f.label :designation %>
          <%= f.text_field :designation %>
        </div>

        <div>
          <%= f.label :profile_image %>
          <%= f.file_field :profile_image %>
        </div>

        <%= f.submit "Submit", class: "btn btn-primary" %>
      <% end %>
    </div>

    <%# 2. Search & Table Section (Moved outside of <table>) %>
    <div class="col-md-6">
      <%= form_with url: employee_index_path, method: :get do |form| %>
        <%= form.text_field :search, value: params[:search], placeholder: "Search employees..." %>
        <%= form.submit "Search" %>
      <% end %>

      <table border="3" cell-padding="2" class="table mt-3">
        <thead>
          <tr> <%# Added missing opening <tr> %>
            <th>Name</th>
            <th>Email</th>
            <th>Phone</th> <%# Changed from Salary to match employee.phone %>
            <th>Designation</th>
            <th>Profile</th>
          </tr>
        </thead>
        <tbody>
          <% if @employees.present? %>
            <% @employees.each do |employee| %>
              <tr>
                <td><%= employee.name %></td>
                <td><%= employee.email %></td>
                <td><%= employee.phone %></td>
                <td><%= employee.designation %></td>
                <td>
                  <% if employee.profile_image.attached? %>
                    <%= image_tag employee.profile_image, width: 100 %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="5">No employees found.</td>
            </tr>
          <% end %>

        </tbody>

      </table>
 <div>
<nav aria-label="Page navigation">
<p>Total Records: <%= @pagy.count %> | Limit: <%= @pagy.items %> | Total Pages: <%= @pagy.pages %></p>

 <% if @pagy.pages > 1 %>
  <nav aria-label="Page navigation">
    <ul class="pagination justify-content-center">
      <%# Previous Button %>
      <% if @pagy.prev %>
        <li class="page-item">
          <%= link_to '&laquo; Previous'.html_safe, url_for(page: @pagy.prev), class: 'page-link' %>
        </li>
      <% else %>
        <li class="page-item disabled"><span class="page-link">&laquo; Previous</span></li>
      <% end %>

      <%# Page Numbers (1, 2, 3...) %>
      <% @pagy.series.each do |item| %>
        <% if item.is_a?(Integer) %>
          <li class="page-item">
            <%= link_to item, url_for(page: item), class: 'page-link' %>
          </li>
        <% elsif item.is_a?(String) %>
          <li class="page-item active">
            <span class="page-link"><%= item %></span>
          </li>
        <% elsif item == :gap %>
          <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
        <% end %>
      <% end %>

      <%# Next Button %>
      <% if @pagy.next %>
        <li class="page-item">
          <%= link_to 'Next &raquo;'.html_safe, url_for(page: @pagy.next), class: 'page-link' %>
        </li>
      <% else %>
        <li class="page-item disabled"><span class="page-link">Next &raquo;</span></li>
      <% end %>
    </ul>
  </nav>
<% end %>

</nav>

</div>


    </div>

  </div>
</div>
