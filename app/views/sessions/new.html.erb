
<div class="row justify-content-center ">
<div class="card mt-5">

  <div class="card-body">
    <% if flash[:alert].present? %>
  <p style="color: red;">
    <%= flash[:alert] %>
  </p>
<% end %>

<% if flash[:notice].present? %>
  <p style="color: green;">
    <%= flash[:notice] %>
  </p>
<% end %>
       <h3>Login</h3>

<%= form_with url: login_path, class: "form-group", method: :post do |f| %>

  <div>
    <%= f.label :email, class: "font-weight-bold"%>
    <%= f.email_field :email, class: "form-control mb-2" %>
  </div>

  <div>
    <%= f.label :password, class: "font-weight-bold" %>
    <%= f.password_field :password, class: "form-control" %>
  </div>

  <%= f.submit "Login", class: "btn btn-primary mt-2" %>

<% end %>
</div>
</div>
