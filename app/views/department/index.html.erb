<%= form_with model: @department, url: department_index_path do |f| %>
  <div>
    <%= f.label :department_name  %>
    <%= f.text_field :department_name  %>
  </div>

  <div>
    <%= f.label :description %>
    <%= f.text_area :description %>
  </div>

  <%= f.submit %>

<% end %>
<% if @department.errors.any? %>
  <div id="error_explanation">
    <h2><%= pluralize(@department.errors.count, "error") %> prohibited this department from being saved:</h2>

    <ul>
      <% @department.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
<table border="1" cellpadding="5" cellspacing="0">
  <thead>
    <tr>
      <th>Department Name</th>
      <th>Description</th>
      <th colspan="2"></th>
    </tr>
  </thead>

  <tbody>
    <% @departments.each do |department| %>
      <tr>
        <td><%= department.department_name %></td>
        <td><%= department.description %></td>
        <td><%= link_to 'Edit', edit_department_path(department) %></td>
        <td><%= link_to 'Delete', department_path(department), method: :delete, data: { confirm: 'Are you sure?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>
